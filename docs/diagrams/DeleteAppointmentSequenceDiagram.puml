@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":LaiNurseParser" as LaiNurseParser LOGIC_COLOR
participant ":DeleteAppointmentCommandParser" as DeleteAppointmentCommandParser LOGIC_COLOR
participant "command:DeleteAppointmentCommand" as DeleteAppointmentCommand LOGIC_COLOR
participant "AppointmentLookup" as AppointmentLookup <<utility>> LOGIC_COLOR
end box

[-> LogicManager : execute("deleteappt S1234567A 1")
activate LogicManager

LogicManager -> LaiNurseParser : parseCommand("deleteappt S1234567A 1")
activate LaiNurseParser

create DeleteAppointmentCommandParser
LaiNurseParser -> DeleteAppointmentCommandParser : DeleteAppointmentCommandParser()
activate DeleteAppointmentCommandParser

DeleteAppointmentCommandParser --> LaiNurseParser
deactivate DeleteAppointmentCommandParser

LaiNurseParser -> DeleteAppointmentCommandParser : parse(" S1234567A 1")
activate DeleteAppointmentCommandParser

create DeleteAppointmentCommand
DeleteAppointmentCommandParser -> DeleteAppointmentCommand : DeleteAppointmentCommand(id, 1)
activate DeleteAppointmentCommand

DeleteAppointmentCommand --> DeleteAppointmentCommandParser
deactivate DeleteAppointmentCommand

DeleteAppointmentCommandParser --> LaiNurseParser : command
deactivate DeleteAppointmentCommandParser

LaiNurseParser --> LogicManager : command
deactivate LaiNurseParser

LogicManager -> DeleteAppointmentCommand : execute(model)
activate DeleteAppointmentCommand

DeleteAppointmentCommand -> AppointmentLookup : find(targetId, schedule,\ntargetAppointment, COMMAND_WORD)
activate AppointmentLookup

AppointmentLookup --> DeleteAppointmentCommand : foundAppointment
deactivate AppointmentLookup

DeleteAppointmentCommand --> LogicManager : new CommandResult(message)\n.withSelectionCleared()
deactivate DeleteAppointmentCommand

[<-- LogicManager : finalResult
deactivate LogicManager
@enduml
