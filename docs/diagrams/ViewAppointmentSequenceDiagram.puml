@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":LaiNurseParser" as LaiNurseParser LOGIC_COLOR
participant ":ViewAppointmentCommandParser" as ViewAppointmentCommandParser LOGIC_COLOR
participant "d:ViewAppointmentCommand" as ViewAppointmentCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "i:PatientId" as PatientId MODEL_COLOR
participant "inRange:AppointmentBetweenDatesPredicate" as AppointmentBetweenDatesPredicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("viewappt 2026-10-15 --id S1234567A")
activate LogicManager

LogicManager -> LaiNurseParser : parseCommand("viewappt 2026-10-15 --id S1234567A")
activate LaiNurseParser

create ViewAppointmentCommandParser
LaiNurseParser -> ViewAppointmentCommandParser
activate ViewAppointmentCommandParser

ViewAppointmentCommandParser --> LaiNurseParser
deactivate ViewAppointmentCommandParser

LaiNurseParser -> ViewAppointmentCommandParser : parse("2026-10-15 --id S1234567A")
activate ViewAppointmentCommandParser

create PatientId
ViewAppointmentCommandParser -> PatientId : PatientId("S1234567A")
activate PatientId

PatientId --> ViewAppointmentCommandParser
deactivate PatientId

create ViewAppointmentCommand
ViewAppointmentCommandParser -> ViewAppointmentCommand : ViewAppointmentCommand(2026-10-15, 2026-10-15, i)
activate ViewAppointmentCommand

ViewAppointmentCommand --> ViewAppointmentCommandParser
deactivate ViewAppointmentCommand

ViewAppointmentCommandParser --> LaiNurseParser : d
deactivate ViewAppointmentCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
ViewAppointmentCommandParser -[hidden]-> LaiNurseParser
destroy ViewAppointmentCommandParser

LaiNurseParser --> LogicManager : d
deactivate LaiNurseParser

LogicManager -> ViewAppointmentCommand : execute(m)
activate ViewAppointmentCommand

create AppointmentBetweenDatesPredicate
ViewAppointmentCommand -> AppointmentBetweenDatesPredicate : AppointmentBetweenDatesPredicate(start, end)
activate AppointmentBetweenDatesPredicate

AppointmentBetweenDatesPredicate --> ViewAppointmentCommand
deactivate AppointmentBetweenDatesPredicate

ViewAppointmentCommand -> Model : findPatientById(S1234567A)
activate Model

Model --> ViewAppointmentCommand : p
deactivate Model

create CommandResult
ViewAppointmentCommand -> CommandResult : CommandResult(..., AppointmentRange(start, end, i))
activate CommandResult

CommandResult --> ViewAppointmentCommand
deactivate CommandResult

ViewAppointmentCommand --> LogicManager : r
deactivate ViewAppointmentCommand

[<--LogicManager
deactivate LogicManager
@enduml
