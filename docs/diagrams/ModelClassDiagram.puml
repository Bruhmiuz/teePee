@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyLaiNurse" as ReadOnlyLaiNurse
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class LaiNurse
Class ModelManager
Class UserPrefs

Class UniquePatientList
Class Patient
Class PatientId
Class Name
Class Phone
Class Address
Class MedicalHistory
Class Notes
Class AppointmentSchedule
Class Appointment

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

LaiNurse .up.|> ReadOnlyLaiNurse

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyLaiNurse
ModelManager -left-> "1" LaiNurse
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

LaiNurse *--> "1" UniquePatientList
UniquePatientList --> "~* all" Patient
Patient *--> "1" PatientId
Patient *--> "1" Name
Patient *--> "1" Phone
Patient *--> "1" Address
Patient *--> "0..1" MedicalHistory
Patient *--> "0..1" Notes
Patient *--> "1" AppointmentSchedule
AppointmentSchedule --> "*" Appointment

Patient -[hidden]up--> I
UniquePatientList -[hidden]right-> I

PatientId -[hidden]right-> Name
Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> MedicalHistory
MedicalHistory -[hidden]right-> Notes

ModelManager --> "~* filtered" Patient
@enduml
