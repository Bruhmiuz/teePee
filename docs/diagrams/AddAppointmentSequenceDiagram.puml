@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":LaiNurseParser" as LaiNurseParser LOGIC_COLOR
participant ":AddAppointmentCommandParser" as AddAppointmentCommandParser LOGIC_COLOR
participant "command:AddAppointmentCommand" as AddAppointmentCommand LOGIC_COLOR
participant "Messages" as Messages <<utility>> LOGIC_COLOR
end box

[-> LogicManager : execute(\n"addappt S1234567A ~--date 2026-12-01 10:00")
activate LogicManager

LogicManager -> LaiNurseParser : parseCommand(\n"addappt S1234567A ~--date 2026-12-01 10:00")
activate LaiNurseParser

create AddAppointmentCommandParser
LaiNurseParser -> AddAppointmentCommandParser : AddAppointmentCommandParser()
activate AddAppointmentCommandParser

AddAppointmentCommandParser --> LaiNurseParser
deactivate AddAppointmentCommandParser

LaiNurseParser -> AddAppointmentCommandParser : parse(\n" S1234567A ~--date 2026-12-01 10:00")
activate AddAppointmentCommandParser

create AddAppointmentCommand
AddAppointmentCommandParser -> AddAppointmentCommand : AddAppointmentCommand(id, toAdd)
activate AddAppointmentCommand

AddAppointmentCommand --> AddAppointmentCommandParser
deactivate AddAppointmentCommand

AddAppointmentCommandParser --> LaiNurseParser : command
deactivate AddAppointmentCommandParser

LaiNurseParser --> LogicManager : command
deactivate LaiNurseParser

LogicManager -> AddAppointmentCommand : execute(model)
activate AddAppointmentCommand

AddAppointmentCommand -> Messages : formatClashWarning(model, created)
activate Messages

Messages --> AddAppointmentCommand : warning
deactivate Messages

AddAppointmentCommand -> Messages : formatArchivedNote(editedPatient, settings)
activate Messages

Messages --> AddAppointmentCommand : archivedNote
deactivate Messages

AddAppointmentCommand --> LogicManager : new CommandResult(message)\n.withNavigation(Navigation.toAppointment(created))
deactivate AddAppointmentCommand

[<-- LogicManager : finalResult
deactivate LogicManager
@enduml
