<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="patient-detail" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="placeholder" styleClass="patient-detail-placeholder" wrapText="true" />
  <!-- Long details scroll down; they are never cut off, and never scroll sideways. The vertical scroll bar always
       shows, so that the width of the text does not depend on it: a bar that comes and goes changes where the text
       wraps, and so whether the details need the bar, which makes the panel flicker at some sizes. -->
  <ScrollPane fx:id="details" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
    <VBox spacing="20">
      <padding>
        <Insets top="20" right="24" bottom="20" left="24" />
      </padding>
      <HBox alignment="BASELINE_LEFT" spacing="12">
        <Label fx:id="name" styleClass="patient-detail-name" wrapText="true">
          <minHeight>
            <!-- Ensures that a long name wraps instead of being cut off -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minHeight>
        </Label>
        <Label fx:id="patientId" styleClass="patient-detail-id">
          <minWidth>
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
      </HBox>
      <GridPane hgap="20" vgap="13">
        <!-- In a narrow panel, the values shrink first, to the width of a long word such as "OSTEOARTHRITIS",
             and then the keys, to the width of "Medical history", so that words are not broken. -->
        <columnConstraints>
          <ColumnConstraints minWidth="110" prefWidth="150" />
          <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="120" />
        </columnConstraints>
        <Label text="Phone" styleClass="patient-detail-key"
               GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.valignment="TOP" />
        <Label fx:id="phone" styleClass="patient-detail-value" wrapText="true"
               GridPane.rowIndex="0" GridPane.columnIndex="1">
          <minHeight>
            <Region fx:constant="USE_PREF_SIZE" />
          </minHeight>
        </Label>
        <Label text="Address" styleClass="patient-detail-key"
               GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP" />
        <Label fx:id="address" styleClass="patient-detail-value" wrapText="true"
               GridPane.rowIndex="1" GridPane.columnIndex="1">
          <minHeight>
            <Region fx:constant="USE_PREF_SIZE" />
          </minHeight>
        </Label>
        <Label text="Medical history" styleClass="patient-detail-key"
               GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="TOP" />
        <Label fx:id="medicalHistory" styleClass="patient-detail-value" wrapText="true"
               GridPane.rowIndex="2" GridPane.columnIndex="1">
          <minHeight>
            <Region fx:constant="USE_PREF_SIZE" />
          </minHeight>
        </Label>
        <Label text="Notes" styleClass="patient-detail-key"
               GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP" />
        <Label fx:id="notes" styleClass="patient-detail-value" wrapText="true"
               GridPane.rowIndex="3" GridPane.columnIndex="1">
          <minHeight>
            <Region fx:constant="USE_PREF_SIZE" />
          </minHeight>
        </Label>
      </GridPane>
      <VBox>
        <HBox styleClass="detail-section-header" alignment="BASELINE_LEFT" spacing="10">
          <Label text="Appointments" styleClass="detail-section-title" />
          <Label fx:id="upcomingNote" styleClass="detail-section-note" />
        </HBox>
        <VBox fx:id="upcomingRows" />
        <VBox fx:id="pastSection">
          <HBox styleClass="detail-past-header" alignment="BASELINE_LEFT" spacing="10">
            <Label text="Past" styleClass="detail-past-title" />
            <Label fx:id="pastNote" styleClass="detail-section-note" />
          </HBox>
          <VBox fx:id="pastRows" />
        </VBox>
      </VBox>
    </VBox>
  </ScrollPane>
</StackPane>
